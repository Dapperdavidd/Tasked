# Copy to .env and adjust. Never commit .env.
#
# Local development assumes a Postgres 16 instance you already run
# (Homebrew, Postgres.app, or docker). `scripts/db.sh setup` creates the
# database and applies every migration in ./migrations.
#
# The username must be explicit. Unlike libpq, sqlx does not fall back to the
# OS user; it connects as "anonymous" and fails with a confusing role error.
DATABASE_URL=postgres://YOUR_OS_USER@localhost:5432/tracked_dev

# Used by `scripts/db.sh reset` only, so a fat-fingered reset cannot point at
# anything that matters.
TRACKED_ALLOW_RESET=0
